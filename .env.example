# LLM provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional second source. Without it, Hacker News is used as a keyless fallback.
SERPER_API_KEY=

# "agent" (deepagents orchestrated) or "pipeline" (deterministic, no LLM loop)
ORCHESTRATION_MODE=agent

ARTIFACTS_DIR=./artifacts
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_SECONDS=600
MAX_DOCUMENTS_PER_COMPANY=8
MIN_COMPETITORS=4
DEBUG=false
